<!--     <!-\-     <problem> -\-> -->
<!--     <!-\-       <idx><h><m>\QQ</m></h><h>has measure zero in <m>\RR</m></h></idx> -\-> -->
<!--     <!-\-       <idx><h>measure zero</h><h><m>\QQ</m> has measure zero in <m>\RR</m></h></idx> -\-> -->
<!--     <!-\-       <statement> -\-> -->

<!--     <!-\-         <p> -\-> -->
<!--     <!-\-           Prove <xref ref="cor_Q-MeasureZero"></xref>.  -\-> -->
<!--     <!-\-         </p> -\-> -->
